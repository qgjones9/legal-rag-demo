# -----------------------------------------------------------------------------
# Legal RAG Demo environment configuration
# Copy this file to `.env` and edit values only if you are not using defaults.
# -----------------------------------------------------------------------------

# Qdrant host used by the app.
# - Docker Compose default: qdrant
# - Local run on host machine: localhost
QDRANT_HOST=qdrant

# Ollama host used by the app.
# - Docker Compose default: ollama
# - Local run on host machine: localhost
OLLAMA_HOST=ollama

# Notes:
# - No API keys are required for this project.
# - If running with `docker-compose up`, these defaults should work as-is.
